<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ATLAS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_neon</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <style name="Theme.ATLAS" parent="Base.Theme.ATLAS" />

    <!-- Chips de selección única (objetivo fitness) en naranja -->
    <style name="Atlas.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_goal_bg</item>
        <item name="chipStrokeColor">@color/chip_goal_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_goal_text</item>
        <item name="checkedIconTint">@color/accent_orange</item>
        <item name="rippleColor">@color/accent_orange_glow</item>
    </style>

    <!-- Píldora del ítem activo del BottomNavigationView en naranja -->
    <style name="Atlas.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_orange_glow</item>
    </style>

    <!-- Campos de texto Material 3 adaptados a la paleta oscura de ATLAS -->
    <style name="Atlas.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_input</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/atlas_box_stroke</item>
        <item name="hintTextColor">@color/primary_neon</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="errorTextColor">@color/accent_red</item>
        <item name="errorIconTint">@color/accent_red</item>
    </style>

    <!-- ===== Sistema de diseño ATLAS v2 ===== -->

    <!-- Tarjeta estándar de todas las pestañas -->
    <style name="Atlas.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/surface_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Escala tipográfica -->
    <style name="Atlas.Text.Screen">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Atlas.Text.Section">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Atlas.Text.CardTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Atlas.Text.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Atlas.Text.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Atlas.Text.Value">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botón principal naranja -->
    <style name="Atlas.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent_orange</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Botón secundario con borde -->
    <style name="Atlas.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/surface_card_stroke</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Botón redondo ± (48 dp, objetivo táctil mínimo) -->
    <style name="Atlas.Button.Round" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/surface_card_stroke</item>
        <item name="cornerRadius">24dp</item>
    </style>
</resources>