<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogDate"
            style="@style/Atlas.Text.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="26 oct" />

        <TextView
            android:id="@+id/tvLogInfo"
            style="@style/Atlas.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            tools:text="3 medidas" />
    </LinearLayout>

    <!-- Diferencia respecto al registro anterior -->
    <TextView
        android:id="@+id/tvLogDelta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="-0.2 kg"
        tools:textColor="@color/primary_neon"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvLogWeight"
        style="@style/Atlas.Text.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="74.8 kg" />

</LinearLayout>
