<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/measuresRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Atlas.Text.Screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/measures_title" />

        <TextView
            style="@style/Atlas.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/measures_subtitle" />

        <!-- Peso corporal -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Atlas.Text.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/measures_weight_title" />

                    <TextView
                        android:id="@+id/tvWeightDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="-0.4 kg"
                        tools:textColor="@color/primary_neon"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinusWeight"
                        style="@style/Atlas.Button.Round"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/measures_weight_minus_desc"
                        android:text="@string/progress_water_minus"
                        android:textColor="@color/text_primary" />

                    <!-- Clicable: abre el diálogo para escribir el peso exacto -->
                    <TextView
                        android:id="@+id/tvCurrentWeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="52dp"
                        android:textColor="@color/text_primary"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="74.8 kg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlusWeight"
                        style="@style/Atlas.Button.Round"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/measures_weight_plus_desc"
                        android:text="@string/progress_water_plus"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWeightToGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/accent_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Estás a 4.8 kg de tu meta" />

                <TextView
                    style="@style/Atlas.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/measures_weight_hint" />

                <com.proyecto.atlas.ui.LineChartView
                    android:id="@+id/chartWeight"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- IMC -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Atlas.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/measures_bmi_title" />

                    <TextView
                        android:id="@+id/tvBmiValue"
                        style="@style/Atlas.Text.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="26sp"
                        tools:text="23.4" />

                    <TextView
                        android:id="@+id/tvBmiLabel"
                        style="@style/Atlas.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Peso normal" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeight"
                    style="@style/Atlas.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="@color/text_primary"
                    tools:text="Estatura: 175 cm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Medidas corporales -->
        <TextView
            style="@style/Atlas.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/measures_body_title" />

        <TextView
            style="@style/Atlas.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/measures_body_hint" />

        <LinearLayout
            android:id="@+id/layoutMeasures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-4dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Historial -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Atlas.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/measures_history_title" />

                <LinearLayout
                    android:id="@+id/layoutBodyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    style="@style/Atlas.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/measures_history_empty"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
