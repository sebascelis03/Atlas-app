<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Atlas.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_weight="1"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivTileIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_flame"
            tools:tint="@color/accent_orange" />

        <TextView
            android:id="@+id/tvTileValue"
            style="@style/Atlas.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            tools:text="5 días" />

        <TextView
            android:id="@+id/tvTileLabel"
            style="@style/Atlas.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            tools:text="Racha" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
