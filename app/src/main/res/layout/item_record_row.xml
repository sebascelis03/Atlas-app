<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/tvRecordRank"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_day_idle"
        android:gravity="center"
        android:textColor="@color/accent_orange"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/tvRecordName"
        style="@style/Atlas.Text.CardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        tools:text="Press de Banca Plano" />

    <TextView
        android:id="@+id/tvRecordWeight"
        style="@style/Atlas.Text.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/accent_orange"
        android:textSize="15sp"
        tools:text="80.0 kg" />
</LinearLayout>
