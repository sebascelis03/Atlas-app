<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Identidad -->
        <TextView
            android:id="@+id/tvProfileAvatar"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_avatar_circle_orange"
            android:contentDescription="@string/profile_avatar_desc"
            android:gravity="center"
            android:textColor="@color/accent_orange"
            android:textSize="38sp"
            android:textStyle="bold"
            tools:text="A" />

        <TextView
            android:id="@+id/tvProfileName"
            style="@style/Atlas.Text.Screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="24sp"
            tools:text="Andrés Pérez" />

        <TextView
            android:id="@+id/tvProfileEmail"
            style="@style/Atlas.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            tools:text="admin@atlas.com" />

        <!-- Nivel del atleta -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Atlas.Text.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_level_label" />

                    <TextView
                        android:id="@+id/tvProfileLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_orange"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/accent_orange"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Intermedio" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:indeterminate="false"
                    android:max="100"
                    app:indicatorColor="@color/accent_orange"
                    app:trackColor="@color/surface_input"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    tools:progress="40" />

                <TextView
                    android:id="@+id/tvLevelDetail"
                    style="@style/Atlas.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:text="12 de 20 entrenamientos para Avanzado" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Peso, meta y racha -->
        <LinearLayout
            android:id="@+id/layoutProfileStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-4dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- Mi plan -->
        <TextView
            style="@style/Atlas.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/profile_plan_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/layoutPlanRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Cuenta -->
        <TextView
            style="@style/Atlas.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/profile_account_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/layoutAccountRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Cerrar sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/profile_logout"
            android:textColor="@color/accent_red"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_danger"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/accent_red"
            app:rippleColor="@color/accent_red"
            app:strokeColor="@color/accent_red"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
