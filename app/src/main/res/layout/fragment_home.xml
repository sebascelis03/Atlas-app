<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <!-- Encabezado: fecha, saludo y avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Atlas.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Lunes, 26 de octubre" />

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/Atlas.Text.Screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Hola, Andrés" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_circle_orange"
                android:contentDescription="@string/home_avatar_desc"
                android:gravity="center"
                android:textColor="@color/accent_orange"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="A" />
        </LinearLayout>

        <!-- Meta semanal + tira de la semana -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressWeeklyGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/accent_orange"
                            app:indicatorSize="76dp"
                            app:trackColor="@color/surface_input"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp"
                            tools:progress="68" />

                        <TextView
                            android:id="@+id/tvWeeklyGoalPercent"
                            style="@style/Atlas.Text.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="17sp"
                            tools:text="68%" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Atlas.Text.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_weekly_goal_title" />

                        <TextView
                            android:id="@+id/tvWeeklyGoalDetail"
                            style="@style/Atlas.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="3 de 4 entrenamientos" />

                        <TextView
                            android:id="@+id/tvWeeklyGoalHint"
                            style="@style/Atlas.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            tools:text="Te falta 1 para tu meta" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutWeekStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mini estadísticas -->
        <LinearLayout
            android:id="@+id/layoutQuickStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-4dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- Sección: rutina sugerida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Atlas.Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_today_label" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/home_see_all"
                android:textColor="@color/accent_orange"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="18dp"
                android:paddingTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTodayTitle"
                            style="@style/Atlas.Text.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Día 1: Empuje (Push)" />

                        <TextView
                            android:id="@+id/tvTodayMuscles"
                            style="@style/Atlas.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="Pecho, Hombro y Tríceps" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTodayDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_orange"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/home_done_today"
                        android:textColor="@color/accent_orange"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTodayMeta"
                    style="@style/Atlas.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textStyle="bold"
                    tools:text="5 ejercicios • 50 min" />

                <LinearLayout
                    android:id="@+id/layoutTodayExercises"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvTodayEmpty"
                    style="@style/Atlas.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="18dp"
                    android:text="@string/home_no_routines"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartWorkout"
                    style="@style/Atlas.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/home_start_workout"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/bg_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidratación -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Atlas.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile"
                        android:contentDescription="@null"
                        android:padding="11dp"
                        android:src="@drawable/ic_drop"
                        app:tint="@color/accent_cyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Atlas.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_water_title" />

                        <TextView
                            android:id="@+id/tvWaterCount"
                            style="@style/Atlas.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            tools:text="3 / 8 vasos" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinusWater"
                        style="@style/Atlas.Button.Round"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/home_water_minus_desc"
                        android:text="@string/progress_water_minus"
                        android:textColor="@color/accent_cyan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlusWater"
                        style="@style/Atlas.Button.Round"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/home_water_plus_desc"
                        android:text="@string/progress_water_plus"
                        android:textColor="@color/accent_cyan" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminate="false"
                    android:max="100"
                    app:indicatorColor="@color/accent_cyan"
                    app:trackColor="@color/surface_input"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    tools:progress="40" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
