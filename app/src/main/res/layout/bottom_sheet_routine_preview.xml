<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@color/surface_card_stroke" />

        <TextView
            android:id="@+id/tvPreviewTitle"
            style="@style/Atlas.Text.Screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            tools:text="Día 1: Empuje (Push)" />

        <TextView
            android:id="@+id/tvPreviewMuscles"
            style="@style/Atlas.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Pecho, Hombro y Tríceps" />

        <TextView
            android:id="@+id/tvPreviewMeta"
            style="@style/Atlas.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textStyle="bold"
            tools:text="5 ejercicios • 50 min" />

        <LinearLayout
            android:id="@+id/layoutPreviewExercises"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvPreviewEmpty"
            style="@style/Atlas.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/routines_preview_empty"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewStart"
            style="@style/Atlas.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="@string/routines_preview_start"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/bg_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewEdit"
                style="@style/Atlas.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/routines_preview_edit"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewDelete"
                style="@style/Atlas.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/routines_preview_delete"
                android:textColor="@color/accent_red"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/accent_red"
                app:strokeColor="@color/accent_red" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
