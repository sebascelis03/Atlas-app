<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/routines_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Nombre del bloque -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRoutineName"
        style="@style/Atlas.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/routines_dialog_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRoutineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            app:placeholderText="@string/routines_dialog_name_placeholder"
            app:placeholderTextColor="@color/text_muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Músculos principales -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRoutineMuscles"
        style="@style/Atlas.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/routines_dialog_muscles_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRoutineMuscles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            app:placeholderText="@string/routines_dialog_muscles_placeholder"
            app:placeholderTextColor="@color/text_muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRoutine"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/routines_dialog_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRoutine"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="22dp"
            android:text="@string/routines_dialog_save"
            android:textColor="@color/bg_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_orange"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
